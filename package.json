{
  "name": "cloud-domain-certificate-manager",
  "version": "1.0.0",
  "description": "Multi-cloud domain binding and automated certificate management system",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "nodemon server/index.js",
    "build": "npm run build:server && npm run build:client",
    "build:server": "echo 'Server ready'",
    "build:client": "cd client && npm run build",
    "db:init": "node scripts/initDb.js",
    "db:seed": "node scripts/seedDb.js",
    "test": "jest",
    "lint": "eslint ."
  },
  "keywords": [
    "domain",
    "certificate",
    "ssl",
    "aliyun",
    "tencentcloud",
    "aws",
    "acme",
    "letsencrypt"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "express-jwt": "^8.4.1",
    "jsonwebtoken": "^9.0.0",
    "bcryptjs": "^2.4.3",
    "sequelize": "^6.35.1",
    "sqlite3": "^5.1.6",
    "mysql2": "^3.6.5",
    "dotenv": "^16.3.1",
    "axios": "^1.6.0",
    "acme": "^2.3.1",
    "acme-client": "^4.7.0",
    "alibabacloud_dysmsapi20170525": "^2.11.0",
    "@alibabacloud/credentials": "^1.3.0",
    "@alibabacloud/tea-util": "^1.4.1",
    "tencentcloud-sdk-nodejs": "^4.0.683",
    "aws-sdk": "^2.1500.0",
    "node-cron": "^3.0.2",
    "winston": "^3.11.0",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-validator": "^7.0.0",
    "multer": "^1.4.5-lts.1",
    "uuid": "^9.0.1",
    "moment": "^2.29.4"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "supertest": "^6.3.3"
  }
}
