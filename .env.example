.env.example
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password
DB_NAME=cloud_domain_cert
DB_DIALECT=mysql

JWT_SECRET=your-secret-key-here-change-in-production
JWT_EXPIRY=7d

ALIYUN_ACCESS_KEY_ID=your-aliyun-key
ALIYUN_ACCESS_KEY_SECRET=your-aliyun-secret
ALIYUN_DOMAIN_ENDPOINT=https://alidns.aliyuncs.com

TENCENTCLOUD_SECRET_ID=your-tencentcloud-id
TENCENTCLOUD_SECRET_KEY=your-tencentcloud-key

AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret
AWS_REGION=us-east-1

LETSENCRYPT_EMAIL=admin@example.com
LETSENCRYPT_ENVIRONMENT=production

LOG_LEVEL=info
NODE_ENV=development
PORT=3000
